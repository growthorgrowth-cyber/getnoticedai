<style>
  @font-face{font-family:"Sora";src:url("/assets/fonts/sora-600.woff2") format("woff2");font-weight:600;font-style:normal;font-display:swap}
  @font-face{font-family:"Sora";src:url("/assets/fonts/sora-700.woff2") format("woff2");font-weight:700;font-style:normal;font-display:swap}
  @font-face{font-family:"Sora";src:url("/assets/fonts/sora-800.woff2") format("woff2");font-weight:800;font-style:normal;font-display:swap}
  @font-face{font-family:"Manrope";src:url("/assets/fonts/manrope-400.woff2") format("woff2");font-weight:400;font-style:normal;font-display:swap}
  @font-face{font-family:"Manrope";src:url("/assets/fonts/manrope-500.woff2") format("woff2");font-weight:500;font-style:normal;font-display:swap}
  @font-face{font-family:"Manrope";src:url("/assets/fonts/manrope-600.woff2") format("woff2");font-weight:600;font-style:normal;font-display:swap}
  @font-face{font-family:"Manrope";src:url("/assets/fonts/manrope-700.woff2") format("woff2");font-weight:700;font-style:normal;font-display:swap}
  @font-face{font-family:"Manrope";src:url("/assets/fonts/manrope-800.woff2") format("woff2");font-weight:800;font-style:normal;font-display:swap}

  :root{
    --paper:#faf8f3; --paper-2:#f1eee6; --card:#ffffff;
    --ink:#17211d; --ink-soft:#4a5a53; --ink-faint:#7c8b84;
    --pine:#0e6b5b; --pine-dark:#0a544a; --pine-deep:#083f38;
    --mint:#43b48f; --mint-soft:#e2f1ea;
    --line:#e4e0d6; --star:#f0a93b; --danger:#b3332d;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{font-family:"Manrope",system-ui,sans-serif;background:var(--paper);color:var(--ink);-webkit-font-smoothing:antialiased;line-height:1.5;overflow-x:hidden}
  h1,h2,h3,h4{font-family:"Sora",sans-serif;letter-spacing:-0.02em}
  a{text-decoration:none;color:inherit}
  img{display:block;max-width:100%}
  ::selection{background:var(--mint-soft);color:var(--pine-deep)}

  .wrap{max-width:72rem;margin:0 auto;padding-left:1.25rem;padding-right:1.25rem}
  .section{padding-block:4.5rem}
  .eyebrow{display:inline-flex;align-items:center;gap:0.4rem;border-radius:9999px;padding:0.35rem 0.8rem;font-family:"Sora",sans-serif;font-weight:600;font-size:0.75rem;letter-spacing:0.04em;text-transform:uppercase;color:var(--pine-deep);background:var(--mint-soft)}
  .sec-head{max-width:40rem;margin:0 auto;text-align:center}
  .sec-head h2{margin-top:1rem;font-size:clamp(1.75rem,3.2vw,2.5rem);font-weight:700;line-height:1.1}
  .sec-head .sub{margin-top:1rem;font-size:1.125rem;color:var(--ink-soft)}

  .btn-audit{display:inline-flex;align-items:center;gap:0.5rem;justify-content:center;border-radius:999px;padding:0.95rem 1.6rem;font-family:"Sora",sans-serif;font-weight:700;font-size:1rem;color:#fff;background:linear-gradient(135deg,var(--pine) 0%,var(--pine-dark) 100%);box-shadow:0 12px 24px -10px rgba(10,84,74,.55);transition:transform .15s ease,box-shadow .15s ease}
  .btn-audit:hover{transform:translateY(-2px);box-shadow:0 16px 30px -12px rgba(10,84,74,.6)}
  .btn-ghost{display:inline-flex;align-items:center;gap:0.5rem;justify-content:center;border-radius:999px;padding:0.9rem 1.5rem;font-family:"Sora",sans-serif;font-weight:600;font-size:1rem;color:var(--pine-deep);background:#fff;border:1px solid var(--line);transition:border-color .15s,background .15s,transform .15s}
  .btn-ghost:hover{border-color:var(--pine);background:var(--mint-soft);transform:translateY(-1px)}
  .btn-text{display:inline-flex;align-items:center;gap:0.4rem;font-family:"Sora",sans-serif;font-weight:700;font-size:0.95rem;color:var(--pine);border-bottom:2px solid var(--pine);padding-bottom:2px}
  .btn-white{display:inline-flex;align-items:center;gap:0.5rem;justify-content:center;border-radius:999px;padding:0.9rem 1.5rem;font-family:"Sora",sans-serif;font-weight:700;font-size:1rem;color:var(--pine-deep);background:#fff;transition:transform .15s,box-shadow .15s}
  .btn-white:hover{transform:translateY(-2px);box-shadow:0 12px 24px -12px rgba(0,0,0,.35)}

  .field-label{display:block;font-family:"Sora",sans-serif;font-weight:600;font-size:0.8rem;margin-bottom:0.4rem;color:var(--ink)}
  .field-input{width:100%;border-radius:0.75rem;border:1px solid var(--line);background:#fff;padding:0.8rem 1rem;font-size:1rem;color:var(--ink);font-family:"Manrope",sans-serif;transition:border-color .15s,box-shadow .15s}
  .field-input::placeholder{color:var(--ink-faint)}
  .field-input:focus{outline:none;border-color:var(--pine);box-shadow:0 0 0 3px var(--mint-soft)}
  .form-note{margin-top:0.5rem;font-size:0.75rem;color:var(--ink-faint)}
  .dark .form-note{color:rgba(255,255,255,.7)}
  .dark .field-label{color:#fff}
  .dark .field-input{border-color:rgba(255,255,255,.25);background:rgba(255,255,255,.08);color:#fff}
  .dark .field-input::placeholder{color:rgba(255,255,255,.6)}

  .topbar{background:var(--pine-deep);color:#fff;text-align:center;padding:0.6rem 1rem;font-size:0.9rem}
  .topbar b{color:var(--mint)}
  .topbar code{background:rgba(255,255,255,.15);border-radius:4px;padding:0.1rem 0.4rem;font-weight:700}

  .nav{position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;height:4rem;background:rgba(250,248,243,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
  section[id], main [id]{scroll-margin-top:5rem}
  .brand{display:flex;align-items:center;gap:0.65rem;font-family:"Sora",sans-serif;font-weight:700;font-size:1.125rem}
  .brand .mark{width:2.25rem;height:2.25rem;border-radius:0.75rem;background:var(--pine);display:grid;place-items:center;color:#fff}
  .nav-links{display:flex;gap:1.75rem;font-size:0.875rem;font-weight:600;color:var(--ink-soft)}
  .nav-links a:hover{color:var(--pine)}
  .nav-cta{display:flex;align-items:center;gap:0.75rem}
  .nav-command-mobile{display:none;align-items:center;border:1px solid var(--pine);border-radius:999px;padding:0.45rem 0.7rem;color:var(--pine-deep);font-family:"Sora",sans-serif;font-size:0.75rem;font-weight:700}
  @media (max-width:820px){.nav-links{display:none}}
  @media (max-width:520px){
    .nav-cta{gap:0.4rem}
    .nav-cta .btn-text{display:none}
    .nav-command-mobile{display:inline-flex}
    .nav .brand{gap:0.45rem;font-size:0.95rem;white-space:nowrap}
    .nav .brand .mark{width:2rem;height:2rem;border-radius:0.65rem}
    .nav-cta .btn-audit{padding-inline:0.8rem !important}
  }

  .hero{position:relative;overflow:hidden}
  .hero::before{content:"";position:absolute;inset:0;pointer-events:none;background:
    radial-gradient(60% 50% at 85% 0%, #e2f1ea 0%, rgba(226,241,234,0) 60%),
    radial-gradient(40% 40% at 5% 100%, #f1eee6 0%, rgba(241,238,230,0) 60%)}
  .hero-grid{position:relative;display:grid;gap:2.5rem;align-items:center;padding:3.5rem 1.25rem 4rem}
  .hero-grid > *{min-width:0}
  @media (min-width:64rem){.hero-grid{grid-template-columns:1.05fr 1fr;padding-top:4.5rem}}
  .hero h1{margin-top:1.1rem;font-size:clamp(2.25rem,5.2vw,3.75rem);font-weight:800;line-height:1.05;letter-spacing:-0.03em}
  .hero p.lead{margin-top:1.1rem;max-width:36rem;font-size:1.125rem;color:var(--ink-soft);line-height:1.6}
  .hero-ctas{display:flex;flex-wrap:wrap;gap:0.75rem;margin-top:1.6rem}
  .hero-bullets{display:flex;flex-wrap:wrap;gap:0.6rem 1.25rem;margin-top:1.4rem;font-size:0.875rem;color:var(--ink-soft)}
  .hero-bullets .tick{color:var(--pine);font-weight:800}
  .hero-visual{position:relative;min-width:0;max-width:100%;margin-top:1.5rem}
  @media (min-width:64rem){.hero-visual{margin-top:0}}
  .dashframe{border-radius:1rem;border:1px solid var(--line);background:#fff;overflow:hidden;box-shadow:0 24px 50px -20px rgba(8,63,56,.32);max-width:100%}
  .dashframe img{width:100%;height:auto}
  .dashframe .bar{display:flex;align-items:center;gap:0.375rem;padding:0.75rem 1rem;background:var(--paper-2);border-bottom:1px solid var(--line)}
  .dot{width:0.6rem;height:0.6rem;border-radius:50%}
  .float-chip{position:absolute;background:#fff;border:1px solid var(--line);border-radius:1rem;padding:0.6rem 0.9rem;box-shadow:0 1px 2px rgba(23,33,29,.05),0 10px 30px -12px rgba(23,33,29,.18)}
