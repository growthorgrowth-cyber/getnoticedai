<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://getnoticedai.com/#organization","name":"Get Noticed AI","legalName":"Infinite Intelligence Ventures LLC","url":"https://getnoticedai.com/","logo":"https://getnoticedai.com/logo.png","email":"eric@getnoticedai.com","telephone":"+1-727-270-9961","address":{"@type":"PostalAddress","streetAddress":"1260 Northlake Blvd #1018","addressLocality":"Palm Beach Gardens","addressRegion":"FL","postalCode":"33410","addressCountry":"US"}},{"@type":"WebSite","@id":"https://getnoticedai.com/#website","url":"https://getnoticedai.com/","name":"Get Noticed AI","publisher":{"@id":"https://getnoticedai.com/#organization"}},{"@type":"WebPage","@id":"https://getnoticedai.com/#webpage","url":"https://getnoticedai.com/","name":"Get Noticed AI | Google Business Profile Optimization","description":"Nova runs your Google Business Profile 24/7, building citations, posting, and answering reviews so you rank on Google Maps, ChatGPT, and Gemini.","isPartOf":{"@id":"https://getnoticedai.com/#website"},"inLanguage":"en-US"},{"@type":"FAQPage","@id":"https://getnoticedai.com/#faq","url":"https://getnoticedai.com/#faq","mainEntity":[{"@type":"Question","name":"How fast can I get set up?","acceptedAnswer":{"@type":"Answer","text":"About 10 minutes. You fill one intake form, connect your Google Business Profile, and Nova starts optimizing the same day. No technical or SEO knowledge needed."}},{"@type":"Question","name":"Will this get my profile flagged or suspended?","acceptedAnswer":{"@type":"Answer","text":"No. Nova only uses white-hat, Google-approved methods: real posts, real review replies, accurate citations, and on-profile optimization. We stay inside Google Business Profile best practices at all times."}},{"@type":"Question","name":"How long until I see results?","acceptedAnswer":{"@type":"Answer","text":"Most owners see movement in 30 to 90 days. Local ranking compounds, so visibility keeps building the longer Nova runs."}},{"@type":"Question","name":"Do I have to stay on contract?","acceptedAnswer":{"@type":"Answer","text":"No. Cancel any time, no contracts, no lock-in. The service is billed per Google Business Profile, monthly or yearly."}},{"@type":"Question","name":"Does this help me rank on ChatGPT and Gemini?","acceptedAnswer":{"@type":"Answer","text":"Yes. Nova builds citations and content across the directories AI search tools reference, so your business is more likely to be recommended in AI answers too."}},{"@type":"Question","name":"Can I manage more than one business?","acceptedAnswer":{"@type":"Answer","text":"Yes. Add as many Google Business Profiles as you need and they all appear in one dashboard. Each profile is billed separately at the plan rate."}},{"@type":"Question","name":"What if my profiles are on different Google accounts?","acceptedAnswer":{"@type":"Answer","text":"No problem. You can connect profiles spread across multiple Google accounts and manage them all from the same dashboard."}},{"@type":"Question","name":"Is citation building included?","acceptedAnswer":{"@type":"Answer","text":"Citation management across 62+ directories and the major data aggregators is included in the Authority plan. Growth includes everything else except citations."}},{"@type":"Question","name":"How is this different from a dashboard tool?","acceptedAnswer":{"@type":"Answer","text":"Most tools are dashboards where you do the work. Nova is an agent, it does the work for you: writes posts, replies to reviews, builds citations, and publishes on schedule. You set it up and leave it."}},{"@type":"Question","name":"Can I use this alongside GoHighLevel (GHL)?","acceptedAnswer":{"@type":"Answer","text":"Yes, and agencies often use them together. GHL is an excellent CRM that handles leads, communication, and pipelines. Nova is the specialized SEO fulfillment layer that does the actual posting, optimization, and ranking work. Together they form a complete local marketing stack."}},{"@type":"Question","name":"Do I have to approve content before it posts?","acceptedAnswer":{"@type":"Answer","text":"No, but you can. Choose fully automated, or have Nova ask for your approval before any content type publishes. Over 80% of clients let Nova run on autopilot without approving first."}},{"@type":"Question","name":"What languages does it work in?","acceptedAnswer":{"@type":"Answer","text":"Nova writes content in dozens of major languages, including English, Spanish, French, German, Italian, Portuguese, Chinese, Japanese, Korean, Arabic, and Hindi, among many others."}},{"@type":"Question","name":"How does this automate social media too?","acceptedAnswer":{"@type":"Answer","text":"Nova takes every Google post and repurposes it to Facebook, Instagram, and LinkedIn, and can create and publish YouTube videos, all on schedule. One system runs your Google profile and your social presence without extra effort."}},{"@type":"Question","name":"Do you offer live support?","acceptedAnswer":{"@type":"Answer","text":"Yes. Live chat is built in, and the team can do screen-share calls when needed. Instant AI answers handle common questions 24/7."}},{"@type":"Question","name":"Is there an affiliate program?","acceptedAnswer":{"@type":"Answer","text":"Yes. Growth and Authority referrals earn 20% recurring commission while the referred subscription remains active. Command referrals earn a $1,000 flat fee after the referred client’s implementation payment is received. See the partner program →"}}]}]}
</script>

